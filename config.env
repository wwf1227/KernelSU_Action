# KernelSU Action -- build profile 小米10 umi SM8250 4.19
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
#小米官方骁龙865 sm8250内核源码，umi‑s‑r‑oss分支=MIUI13 Android 12
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=umi-s-r-oss
KERNEL_CONFIG=umi_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KERNEL_NAME=Umi‑ReSukiSU‑SUSFS
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#4.19老内核，选用稳定老版clang，新版clang编译4.19大概率炸编译
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# USE_LLVM=false 4.19不能全开llvm，会编译失败
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# Resukisu 专门优化legacy非‑GKI老内核，支持builtin模式内置SUSFS
KSU_VARIANT=resukisu
# 4.19旧内核强制使用legacy分支
KSU_REF=legacy
# 4.19老内核必须用manual hook，kprobes在小米10内核上大概率失效
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# ✅开启SUSFS！用来隐藏overlayfs挂载痕迹，消除Hunter System Partition Mount Tampering告警
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel‑4.19

# ========================================================== Extra patches ===
#4.19<5.9，必须开启path_umount补丁
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false
# SUSFS必要配置写入defconfig
EXTRA_DEFCONFIG="CONFIG_KSU_SUSFS=y CONFIG_KSU_SUSFS_HIDE_MOUNTS=y"

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
# 如果你想要Action直接打包boot.img，改成true，填入你备份stock_boot的下载直链
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
