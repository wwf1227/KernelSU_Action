# KernelSU Action -- Xiaomi Mi 10 (umi)
#
# Target:
#   Xiaomi Mi 10
#   codename: umi
#   MIUI: V13.0.8.0.SJBCNXM
#   Android: 12
#   Kernel: 4.19.157-perf
#
# First build:
#   - SukiSU-Ultra builtin
#   - manual hook
#   - no KPM
#   - no extra SUSFS patch
#   - no QUIC / SOCKS changes
#
# ================================================================ General ===

CONFIG_ENV=config.env

# ============================================================ Kernel source ===

KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource

KERNEL_SOURCE_BRANCH=cmi-r-oss

KERNEL_CONFIG=vendor/umi_user_defconfig

KERNEL_IMAGE_NAME=Image.gz-dtb

ARCH=arm64

# Device name used for artifact name and CONFIG_LOCALVERSION.
KERNEL_NAME=umi

ADD_LOCALVERSION_TO_FILENAME=false

# ============================================================ Build flags ===

# Keep the original 4.19 build behavior as much as possible.
#
# We do NOT enable LLVM=1 / LLVM_IAS=1 because this is an old
# Qualcomm 4.19 kernel tree.

EXTRA_CMDS=
CUSTOM_CMDS=

# ================================================================ Clang ===

# KernelSU_Action recommends this toolchain for 4.9 ~ 4.19 kernels.
#
# Your original Xiaomi kernel reports:
#   clang version 10.0.7
#
# For the first build, use the toolchain already supported by
# KernelSU_Action. If compilation fails because of compiler
# incompatibility, we will switch to Xiaomi's original toolchain.

CLANG_BRANCH=master-kernel-build-2022

CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=

CUSTOM_CLANG_BRANCH=

# Do NOT use LLVM=1 / LLVM_IAS=1 on this 4.19 tree.
USE_LLVM=false

# =================================================================== GCC ===

# 4.19 Qualcomm kernel still needs GCC/binutils compatibility.

ENABLE_GCC_ARM64=true

ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false

CUSTOM_GCC_64_SOURCE=

CUSTOM_GCC_64_BRANCH=

CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false

CUSTOM_GCC_32_SOURCE=

CUSTOM_GCC_32_BRANCH=

CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

# SukiSU-Ultra:
#   builtin = source-integrated KernelSU
#
# This is the mode we want for Xiaomi Mi 10 4.19 Non-GKI.

KSU_VARIANT=sukisu-ultra

KSU_REF=builtin

# Important for old Non-GKI kernels.
#
# Your kernel:
#   CONFIG_KPROBES is not set
#
# Use manual hooks instead of kprobes.

KSU_HOOK_MODE=manual

# Use official manager signature.
KSU_EXPECTED_SIZE=

KSU_EXPECTED_HASH=

# ================================================================= SUSFS ===

# First build deliberately does NOT apply the external SUSFS patch.
#
# SukiSU-Ultra builtin already contains SUSFS support.

ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git

SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# Linux 4.19 does not have path_umount().
#
# KernelSU_Action provides a backport for old kernels.

ENABLE_PATH_UMOUNT=true

# Do not add extra fingerprint hiding in the first build.
ENABLE_HIDE_STUFF=false

# Do not enable KPM in the first build.
ENABLE_KPM=false

# ================================================================ Kconfig ===

# We already confirmed on the phone:
#
#   CONFIG_KALLSYMS=y
#   CONFIG_KALLSYMS_ALL=y
#   CONFIG_KPROBES is not set
#
# Therefore:
#   - do not add KPROBES
#   - do not modify KALLSYMS
#
ADD_KPROBES_CONFIG=false

# Needed for KernelSU module support / system read-write handling.
ADD_OVERLAYFS_CONFIG=true

# Keep original LTO configuration.
DISABLE_LTO=false

# Keep compiler warnings behavior unchanged initially.
DISABLE_CC_WERROR=false

# No additional Kconfig changes in first build.
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

# Use the AnyKernel3 implementation included by KernelSU_Action.
USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=

CUSTOM_ANYKERNEL3_BRANCH=

# ================================================================ Packaging ===

# First build: do not handle DTBO separately.
NEED_DTBO=false

# Do not rebuild boot.img yet.
#
# First target is:
#
#   AnyKernel3.zip
#
# After the kernel build succeeds, we can decide whether we need
# boot.img repacking for the Mi 10.

BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true

REMOVE_UNUSED_PACKAGES=true